<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.ui.MainController"
            prefHeight="740.0" prefWidth="1200.0">

    <!-- ══ LEFT SIDEBAR ══════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="300.0">

            <!-- Brand header -->
            <VBox styleClass="sidebar-header" spacing="4.0">
                <padding><Insets top="28.0" right="22.0" bottom="22.0" left="22.0"/></padding>
                <Label text="🎰  Ban Roulette" styleClass="app-title"/>
                <Label text="Spin the wheel. Drop the ban." styleClass="app-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-sep"/>

            <!-- Participant input section (grows to fill available height) -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <padding><Insets top="20.0" right="22.0" bottom="16.0" left="22.0"/></padding>

                <Label text="PARTICIPANTS" styleClass="section-label"/>

                <HBox spacing="8.0">
                    <TextField fx:id="nameInput"
                               promptText="Enter a name…"
                               HBox.hgrow="ALWAYS"
                               styleClass="name-input"/>
                    <Button fx:id="addButton"
                            text="Add"
                            styleClass="btn-add"
                            onAction="#onAddName"/>
                </HBox>

                <ListView fx:id="participantList"
                          styleClass="participant-list"
                          VBox.vgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       styleClass="status-label"
                       wrapText="true"/>
            </VBox>

            <!-- Pinned action bar -->
            <VBox styleClass="sidebar-actions" spacing="8.0">
                <padding><Insets top="14.0" right="22.0" bottom="22.0" left="22.0"/></padding>
                <HBox spacing="10.0">
                    <Button fx:id="clearButton"
                            text="Clear All"
                            styleClass="btn-secondary"
                            onAction="#onClearAll"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>
                    <Button fx:id="spinButton"
                            text="⚡  Spin!"
                            styleClass="btn-spin"
                            onAction="#onSpin"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ══ CENTER — WHEEL CANVAS ════════════════════════════════════ -->
    <center>
        <StackPane fx:id="wheelContainer" styleClass="wheel-container">
            <!-- Visible only when < 2 participants are present -->
            <VBox fx:id="wheelPlaceholderBox"
                  styleClass="wheel-placeholder-box"
                  alignment="CENTER"
                  spacing="18.0">
                <Label text="🎡" styleClass="wheel-icon"/>
                <Label fx:id="wheelPlaceholder"
                       text="Add at least 2 participants&#10;to generate the wheel"
                       styleClass="wheel-placeholder"
                       textAlignment="CENTER"
                       wrapText="true"/>
            </VBox>

            <!-- ══ BAN RESULT OVERLAY DIALOG (Step 6) ═════════════════════ -->
            <StackPane fx:id="banDialogOverlay"
                       styleClass="ban-dialog-overlay"
                       visible="false"
                       managed="false">
                <VBox styleClass="ban-dialog-card"
                      alignment="CENTER"
                      spacing="16.0"
                      maxWidth="420.0"
                      maxHeight="300.0">
                    <padding><Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/></padding>

                    <StackPane styleClass="ban-dialog-badge">
                        <Label text="🔨" styleClass="ban-dialog-icon"/>
                    </StackPane>

                    <VBox alignment="CENTER" spacing="6.0">
                        <Label text="BAN HAMMER HAS SPOKEN" styleClass="ban-dialog-subtitle"/>
                        <Label fx:id="banDialogMessage"
                               text="Player has been banned!"
                               styleClass="ban-dialog-title"
                               wrapText="true"
                               textAlignment="CENTER"/>
                    </VBox>

                    <Button fx:id="banDialogDismissBtn"
                            text="Dismiss"
                            styleClass="btn-ban-dismiss"
                            onAction="#onDismissBanDialog"/>
                </VBox>
            </StackPane>
        </StackPane>
    </center>

    <!-- ══ RIGHT SIDEBAR — BANNED LIST & SAVED NAMES ═════════════════ -->
    <right>
        <VBox fx:id="rightSidebar" styleClass="sidebar-right" prefWidth="340.0">
            <!-- ── Panel 1: Banned History Box ─────────────────────── -->
            <VBox fx:id="bannedBox" VBox.vgrow="ALWAYS">
                <!-- Brand / Header -->
                <VBox styleClass="sidebar-header" spacing="4.0">
                    <padding><Insets top="28.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="📜  BANNED LIST" styleClass="section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="bannedCountBadge" text="0" styleClass="badge-count"/>
                    </HBox>
                    <Label text="Fallen participants chosen for ban" styleClass="app-subtitle"/>
                </VBox>

                <Separator styleClass="sidebar-sep"/>

                <!-- Banned TableView (grows to fill height) -->
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/></padding>

                    <TableView fx:id="bannedTable"
                               styleClass="banned-table"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="bannedNameCol"
                                         text="Name"
                                         prefWidth="105.0"/>
                            <TableColumn fx:id="bannedCountCol"
                                         text="Bans"
                                         prefWidth="65.0"/>
                            <TableColumn fx:id="bannedDateCol"
                                         text="Last Ban"
                                         prefWidth="85.0"/>
                            <TableColumn fx:id="bannedActionCol"
                                         text="Action"
                                         prefWidth="65.0"/>
                        </columns>
                        <placeholder>
                            <Label text="No banned participants yet" styleClass="table-placeholder"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Bottom actions for banned list -->
                <VBox styleClass="sidebar-actions" spacing="8.0">
                    <padding><Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                    <Button fx:id="clearBannedBtn"
                            text="Clear History"
                            styleClass="btn-secondary"
                            onAction="#onClearBannedHistory"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- ── Panel 2: Saved Names Catalog Box ────────────────── -->
            <VBox fx:id="savedNamesBox" VBox.vgrow="ALWAYS" visible="false" managed="false">
                <!-- Brand / Header -->
                <VBox styleClass="sidebar-header" spacing="4.0">
                    <padding><Insets top="28.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="📁  SAVED NAMES" styleClass="section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="savedCountBadge" text="0" styleClass="badge-count-saved"/>
                    </HBox>
                    <Label text="Click + Add to add to the roulette" styleClass="app-subtitle"/>
                </VBox>

                <Separator styleClass="sidebar-sep"/>

                <!-- Saved Names content (Filter + ListView) -->
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/></padding>

                    <TextField fx:id="savedNamesFilter"
                               promptText="🔍 Filter saved names…"
                               styleClass="text-input-field"/>

                    <ListView fx:id="savedNamesList"
                              styleClass="saved-names-list"
                              VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No saved names in database yet" styleClass="table-placeholder"/>
                        </placeholder>
                    </ListView>
                </VBox>

                <!-- Bottom actions for saved names -->
                <VBox styleClass="sidebar-actions" spacing="8.0">
                    <padding><Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/></padding>
                    <HBox spacing="8.0">
                        <Button fx:id="addAllSavedBtn"
                                text="+ Add All"
                                styleClass="btn-secondary"
                                onAction="#onAddAllSavedToWheel"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>
                        <Button fx:id="clearSavedBtn"
                                text="Clear All"
                                styleClass="btn-danger-outline"
                                onAction="#onClearSavedNames"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </right>

    <!-- ══ BOTTOM STATUS BAR ════════════════════════════════════════ -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10.0">
            <padding><Insets top="8.0" right="20.0" bottom="8.0" left="20.0"/></padding>
            <Label text="●" styleClass="status-dot"/>
            <Label fx:id="bottomStatus"
                   text="Ready — add names to get started"
                   styleClass="status-bar-text"
                   HBox.hgrow="ALWAYS"
                   maxWidth="Infinity"/>
            <Button fx:id="toggleSavedNamesBtn"
                    text="📁 Saved Names"
                    styleClass="btn-link"
                    onAction="#onToggleSavedNames"/>
            <Button fx:id="toggleHistoryBtn"
                    text="📜 History"
                    styleClass="btn-link"
                    onAction="#onToggleHistory"/>
        </HBox>
    </bottom>
</BorderPane>
